{
  "name": "watchwright",
  "version": "0.0.0",
  "private": true,
  "description": "A browser test harness on Playwright that you watch work live, control from its own website, and drive from your own AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "watchwright": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/cli/main.ts serve",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "better-sqlite3": "^13.0.3",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.7",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  }
}
