{
  "name": "watchwright",
  "version": "0.9.1",
  "description": "A browser test harness on Playwright that you watch work live, control from its own website, and drive from your own AI agents.",
  "license": "Apache-2.0",
  "author": "DumiFlex",
  "homepage": "https://dumiflex.github.io/watchwright/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DumiFlex/watchwright.git",
    "directory": "packages/watchwright"
  },
  "bugs": {
    "url": "https://github.com/DumiFlex/watchwright/issues"
  },
  "keywords": [
    "playwright",
    "testing",
    "browser",
    "e2e",
    "mcp",
    "ai-agents"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "watchwright": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/test.json": "./dist/schema/test.json",
    "./schema/pack.json": "./dist/schema/pack.json"
  },
  "files": [
    "dist",
    "skill",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/write-schemas.mjs && node scripts/copy-demo.mjs",
    "dev": "tsx watch src/cli/main.ts serve",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "steps-reference": "tsx scripts/steps-reference.ts",
    "skill-references": "tsx scripts/skill-references.ts",
    "prepack": "node scripts/copy-legal.mjs",
    "check-package": "tsx scripts/check-package.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fastify/websocket": "^11.3.4",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.7",
    "playwright": "^1.64.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  }
}
